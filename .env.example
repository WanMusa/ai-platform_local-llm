# Copy to .env on the VPS (~/projects/ai-platform_local-llm/.env) and fill in.
# .env is git-ignored and survives `git reset --hard` deploys.

# --- API auth (required) ---
# Clients must send this value using standard HTTP bearer auth (see README).
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
LOCAL_LLM_API_TOKEN=change-me

# --- Shared Gemma backend (OpenAI-compatible /chat/completions) ---
# Examples:
#   Ollama on the ai_platform network:  http://ollama:11434/v1
#   llama.cpp server:                   http://llama-cpp:8080/v1
#   Ollama on the VPS host:             http://host.docker.internal:11434/v1
LLM_BASE_URL=http://ollama:11434/v1
LLM_MODEL=gemma3:4b
# Optional; leave empty if the backend needs no key.
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=120
# Set true if the backend supports response_format={"type":"json_object"}.
LLM_JSON_MODE=false

# Max characters of input text sent to the model (longer input is truncated).
MAX_INPUT_CHARS=24000

# --- Profile tuning ---
EXTRACT_JOB_TEMPERATURE=0.1
EXTRACT_JOB_MAX_TOKENS=1500
HERMES_HELPER_TEMPERATURE=0.5
HERMES_HELPER_MAX_TOKENS=1024

# --- Optional public exposure via ai-platform_infra nginx-proxy ---
# Uncomment the matching lines in docker-compose.yml to enable.
# APP_DOMAIN=llm.example.com
# LETSENCRYPT_EMAIL=you@example.com
